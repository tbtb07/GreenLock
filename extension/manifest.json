{
  "manifest_version": 3,
  "name": "GreenLock",
  "version": "0.8.0",
  "description": "GreenLock browser extension.",
  "permissions": ["tabs", "storage", "alarms", "notifications"],
  "host_permissions": ["http://localhost:5050/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GreenLock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  }
}
